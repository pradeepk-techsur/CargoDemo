# CargoDemo environment configuration (TechArch 05-tech-stack §5.5).
# Copy to .env and adjust as needed. No secret values are committed here.

# Bind address. MUST be 0.0.0.0 for the preview iframe to reach the app.
CARGODEMO_HOST=0.0.0.0

# Deterministic port [AD-05]. No automatic fallback.
CARGODEMO_PORT=3000

# SQLite database file. Unwritable path aborts startup with DB_UNAVAILABLE.
CARGODEMO_DB_PATH=./data/cargodemo.db

# Document storage root; all paths confined inside it.
CARGODEMO_DOC_STORAGE_DIR=./data/documents

# Seed automatically when the database has no cargo entries.
CARGODEMO_SEED_ON_EMPTY=true

# Fixed instant for the deterministic seed clock (SD-03).
CARGODEMO_SEED_CLOCK=2026-09-01T08:00:00.000Z

# AI provider. `none` is the supported demo default and produces zero egress.
CARGODEMO_AI_PROVIDER=none

# Console verbosity only; does not affect request_log.
CARGODEMO_LOG_LEVEL=info
